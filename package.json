{
  "name": "agrisence",
  "version": "0.0.1",
  "private": true,
  "description": "AgriSence — AI-powered smart farming platform (monorepo)",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "setup": "pnpm install"
  },
  "devDependencies": {
    "turbo": "^2.3.4",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.4"
}
