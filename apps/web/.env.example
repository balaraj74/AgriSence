# Environment Variables Template
# Copy this file to .env.local for local development
# For production, set these in Firebase App Hosting environment variables

# ─── Google Cloud / Vertex AI (Required for ALL AI Features) ─────────────────
# AI is powered by Vertex AI — credits are consumed from your GCP billing account
GCLOUD_PROJECT=agrisence-1dc30
GCLOUD_LOCATION=us-central1

# Authentication: Uses Application Default Credentials (ADC) — NO API KEY needed
# Local dev:  run `gcloud auth application-default login`
# Production: Firebase App Hosting auto-detects the service account

# ─── Google Maps ──────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ─── Node Environment ─────────────────────────────────────────────────────────
NODE_ENV=development
